# Cloudflare Pages header rules. Not served as a file.

# Applies everywhere, including the apex, which /*.html would miss.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fonts are content stable and filename stable. Cache hard. Replacing a face
# means renaming the file too, or clients keep the old one for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The mergetool is a shell script served as text, so a browser shows it,
# curl saves it, and nobody gets a mystery download.
/counsel
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Brand assets change rarely, but not never.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=604800

# HTML keeps the Pages default of max-age=0, must-revalidate, so a change of
# wording is available to everyone the moment it is ready to be shared.
